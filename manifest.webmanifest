{
  "name": "MyMoney",
  "short_name": "MyMoney",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0f12",
  "theme_color": "#0d0f12",
  "icons": [
    {
      "src": "icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Add an expense",
      "short_name": "Add",
      "url": "./#add",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Card dues",
      "short_name": "Cards",
      "url": "./#ccards",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "This week and money plan",
      "short_name": "This week",
      "url": "./#mplan",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Why over the limit?",
      "short_name": "Why over",
      "url": "./#whyover",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Say an expense",
      "short_name": "Voice",
      "url": "./#voice",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "At a glance",
      "short_name": "Glance",
      "url": "./#glance",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "New receipt",
      "short_name": "Receipt",
      "url": "receipts.html",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp"
          ]
        }
      ]
    }
  }
}